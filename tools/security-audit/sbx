#!/bin/bash
# OS-enforced sandbox for target-controlled execution (security-audit skill).
#   sbx <scratch-dir> <command...>
# - new network namespace: no external network; loopback only (brought up inside the namespace)
# - new mount + PID namespace; private tmpfs for /tmp, /var/tmp, /dev/shm
# - the audited target and the audit tools are bind-mounted read-only
# - runs as uid/gid 65534 (nobody) with an empty environment; only the scratch dir is writable
# - limits: CPU 300s, wall 600s, data 3 GiB, file size 200 MB, 256 processes, 1024 files
set -euo pipefail
SCR=$(realpath "$1"); shift
[ -d "$SCR" ] || { echo "scratch dir missing" >&2; exit 2; }
chown -R 65534:65534 "$SCR"
exec unshare --mount --net --pid --fork --propagation private -- /bin/bash -c '
  set -e
  SCR="$1"; shift
  python3 - <<PY
import fcntl, socket, struct
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
ifr = struct.pack("16sH", b"lo", 0)
flags = struct.unpack("16sH", fcntl.ioctl(s, 0x8913, ifr))[1]
fcntl.ioctl(s, 0x8914, struct.pack("16sH", b"lo", flags | 1))
PY
  mount -t proc proc /proc
  for d in /tmp /var/tmp /dev/shm; do mount -t tmpfs -o size=512m,mode=1777 tmpfs "$d"; done
  for d in /home/claude/audit-target /home/claude/audit-tools /home/claude/sas /opt/pw-browsers; do
    [ -e "$d" ] && mount --bind "$d" "$d" && mount -o remount,bind,ro "$d"
  done
  mkdir -p "$SCR/home"; chown 65534:65534 "$SCR/home"
  cd "$SCR"
  exec env -i PATH=/usr/lib/postgresql/16/bin:/usr/local/bin:/usr/bin:/bin HOME="$SCR/home" TMPDIR=/tmp LANG=C.UTF-8 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    prlimit --cpu=300 --data=3221225472 --fsize=209715200 --nproc=256 --nofile=1024 -- \
    setpriv --reuid=65534 --regid=65534 --clear-groups --no-new-privs -- timeout 600 "$@"
' bash "$SCR" "$@"
