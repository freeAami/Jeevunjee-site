# The committee's Google Apps Script web-app URL (see apps-script/SETUP.md), e.g.
# https://script.google.com/macros/s/AKfy.../exec
# Leave empty to run in preview mode: submissions are NOT sent anywhere.
VITE_SUBMIT_ENDPOINT=

# The applications Google Sheet. Powers the "Committee access" link in the footer.
VITE_COMMITTEE_URL=

# Background videos. Self-host these before launch (see ASSESSMENT.md).
VITE_HERO_VIDEO=https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260328_083109_283f3553-e28f-428b-a723-d639c617eb2b.mp4
VITE_APPLY_VIDEO=https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260622_202655_a7f5aca0-2f80-4bc9-bcb5-96ac95662003.mp4

# Trustee portal database (see supabase/SETUP.md). The anon/publishable key is safe to publish;
# NEVER put the service_role/secret key here. Empty = the portal runs in preview mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
